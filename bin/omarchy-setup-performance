#!/bin/bash
# omarchy:summary=Reduce background polling for configured optional desktop plugins
set -euo pipefail

python3 - "$HOME/.config/omarchy/shell.json" <<'PY'
import json
import os
from pathlib import Path
import shutil
import sys
import tempfile

path = Path(sys.argv[1])
if not path.exists():
  sys.exit(0)
config = json.loads(path.read_text())
changed = False
for section in config.get('bar', {}).get('layout', {}).values():
  for widget in section:
    if widget.get('id') == 'ryanyogan.omatop' and widget.get('refreshSeconds') != 5:
      widget['refreshSeconds'] = 5
      changed = True
if changed:
  backup = path.with_name(path.name + '.before-performance')
  if not backup.exists():
    shutil.copy2(path, backup)
  descriptor, temporary = tempfile.mkstemp(prefix='.shell-performance-', dir=path.parent)
  try:
    os.fchmod(descriptor, path.stat().st_mode & 0o777)
    with os.fdopen(descriptor, 'w') as stream:
      stream.write(json.dumps(config, indent=2) + '\n')
    os.replace(temporary, path)
  finally:
    if os.path.exists(temporary):
      os.unlink(temporary)
PY
omarchy-shell -q shell reloadConfig
